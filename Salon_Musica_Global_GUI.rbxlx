<?xml version="1.0" encoding="utf-8"?>
<roblox version="4">
  <!--Proyecto de ejemplo: sistema de musica global con GUI animada-->
  <Item class="DataModel">
    <Properties>
      <string name="Name">
        Game
      </string>
    </Properties>
    <Item class="ReplicatedStorage">
      <Properties>
        <string name="Name">
          ReplicatedStorage
        </string>
      </Properties>
    </Item>
    <Item class="ServerScriptService">
      <Properties>
        <string name="Name">
          ServerScriptService
        </string>
      </Properties>
      <Item class="Script">
        <Properties>
          <string name="Name">
            MusicServer
          </string>
          <ProtectedString name="Source"><![CDATA[-- Sistema de musica global - servidor
-- Coloca y administra una sola pista para todos los jugadores del servidor.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local folder = ReplicatedStorage:FindFirstChild("MusicSystem")
if not folder then
    folder = Instance.new("Folder")
    folder.Name = "MusicSystem"
    folder.Parent = ReplicatedStorage
end

local function getRemote(name)
    local remote = folder:FindFirstChild(name)
    if not remote then
        remote = Instance.new("RemoteEvent")
        remote.Name = name
        remote.Parent = folder
    end
    return remote
end

local Request = getRemote("Request")
local Update = getRemote("Update")

local sound = SoundService:FindFirstChild("GlobalPartyMusic")
if not sound then
    sound = Instance.new("Sound")
    sound.Name = "GlobalPartyMusic"
    sound.Volume = 0.5
    sound.Looped = false
    sound.Parent = SoundService
end

local queue = {}
local currentId = nil
local currentRequester = nil
local lastRequest = {}
local MAX_QUEUE = 30

local function snapshot()
    local items = {}
    for i, item in ipairs(queue) do
        items[i] = {
            id = item.id,
            requester = item.requester
        }
    end
    return {
        currentId = currentId,
        currentRequester = currentRequester,
        queue = items,
        isPlaying = sound.IsPlaying,
        timePosition = sound.TimePosition,
        volume = sound.Volume
    }
end

local function broadcast()
    Update:FireAllClients("State", snapshot())
end

local function playNext()
    local nextItem = table.remove(queue, 1)
    if not nextItem then
        currentId = nil
        currentRequester = nil
        sound:Stop()
        broadcast()
        return
    end

    currentId = nextItem.id
    currentRequester = nextItem.requester
    sound:Stop()
    sound.SoundId = "rbxassetid://" .. tostring(currentId)
    sound.TimePosition = 0
    sound:Play()
    broadcast()
end

sound.Ended:Connect(function()
    playNext()
end)

Request.OnServerEvent:Connect(function(player, action, value)
    if action == "GetState" then
        Update:FireClient(player, "State", snapshot())
        return
    end

    local now = os.clock()
    if lastRequest[player.UserId] and now - lastRequest[player.UserId] < 1.2 then
        return
    end
    lastRequest[player.UserId] = now

    if action == "Add" then
        local idText = tostring(value or "")
        local id = tonumber(idText)
        if not id or id < 1 or id % 1 ~= 0 then
            Update:FireClient(player, "Notice", "Escribe un ID de audio válido.")
            return
        end
        if #queue >= MAX_QUEUE then
            Update:FireClient(player, "Notice", "La cola está llena. Inténtalo más tarde.")
            return
        end

        table.insert(queue, {
            id = math.floor(id),
            requester = player.DisplayName
        })

        if not currentId then
            playNext()
        else
            broadcast()
        end
        Update:FireAllClients("Notice", player.DisplayName .. " agregó una canción.")
    elseif action == "Skip" then
        -- En esta versión cualquier jugador puede pedir saltar la pista.
        if currentId then
            playNext()
        end
    elseif action == "Volume" then
        local volume = tonumber(value)
        if volume then
            sound.Volume = math.clamp(volume, 0, 1)
            broadcast()
        end
    end
end)

Players.PlayerRemoving:Connect(function(player)
    lastRequest[player.UserId] = nil
end)

task.wait(1)
broadcast()
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterGui">
      <Properties>
        <string name="Name">
          StarterGui
        </string>
      </Properties>
      <Item class="ScreenGui">
        <Properties>
          <string name="Name">
            PartyMusicGui
          </string>
          <bool name="ResetOnSpawn">
            false
          </bool>
          <bool name="IgnoreGuiInset">
            true
          </bool>
        </Properties>
        <Item class="LocalScript">
          <Properties>
            <string name="Name">
              MusicClient
            </string>
            <ProtectedString name="Source"><![CDATA[-- Interfaz de musica global - cliente
-- GUI original con apertura animada y simbolos decorativos cambiantes.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("MusicSystem")
local Request = remotes:WaitForChild("Request")
local Update = remotes:WaitForChild("Update")

local gui = script.Parent
gui.Name = "PartyMusicGui"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true

local function make(className, props, parent)
    local obj = Instance.new(className)
    for k, v in pairs(props) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end

local accent = Color3.fromRGB(255, 55, 105)
local dark = Color3.fromRGB(18, 18, 27)
local panel = Color3.fromRGB(29, 29, 42)
local muted = Color3.fromRGB(170, 170, 190)

local openButton = make("TextButton", {
    Name = "OpenMusic",
    Text = "♫  MÚSICA",
    Font = Enum.Font.GothamBold,
    TextSize = 14,
    TextColor3 = Color3.new(1,1,1),
    BackgroundColor3 = accent,
    Size = UDim2.fromOffset(126, 42),
    Position = UDim2.new(0, 18, 0.5, -21),
    AutoButtonColor = true
}, gui)
make("UICorner", {CornerRadius = UDim.new(0, 12)}, openButton)

local main = make("Frame", {
    Name = "MusicPanel",
    AnchorPoint = Vector2.new(0.5, 0.5),
    Position = UDim2.new(0.5, 0, 0.5, 18),
    Size = UDim2.fromOffset(0, 0),
    BackgroundColor3 = dark,
    Visible = false,
    ClipsDescendants = true
}, gui)
make("UICorner", {CornerRadius = UDim.new(0, 18)}, main)
make("UIStroke", {Color = accent, Thickness = 1.5, Transparency = 0.15}, main)

local header = make("Frame", {
    BackgroundColor3 = panel,
    Size = UDim2.new(1, 0, 0, 58),
    BorderSizePixel = 0
}, main)
make("UICorner", {CornerRadius = UDim.new(0, 18)}, header)

make("TextLabel", {
    BackgroundTransparency = 1,
    Position = UDim2.fromOffset(17, 7),
    Size = UDim2.new(1, -75, 0, 23),
    Font = Enum.Font.GothamBlack,
    Text = "SALÓN • MUSIC",
    TextColor3 = Color3.new(1,1,1),
    TextSize = 17,
    TextXAlignment = Enum.TextXAlignment.Left
}, header)

make("TextLabel", {
    BackgroundTransparency = 1,
    Position = UDim2.fromOffset(18, 31),
    Size = UDim2.new(1, -80, 0, 16),
    Font = Enum.Font.Gotham,
    Text = "REPRODUCTOR GLOBAL",
    TextColor3 = muted,
    TextSize = 9,
    TextXAlignment = Enum.TextXAlignment.Left
}, header)

local close = make("TextButton", {
    Text = "×",
    Font = Enum.Font.GothamBold,
    TextSize = 25,
    TextColor3 = Color3.new(1,1,1),
    BackgroundColor3 = Color3.fromRGB(55, 48, 65),
    Size = UDim2.fromOffset(36, 36),
    Position = UDim2.new(1, -46, 0, 11)
}, header)
make("UICorner", {CornerRadius = UDim.new(0, 10)}, close)

local symbols = {"♫", "✦", "♪", "✧", "♬", "⋆"}
local symbolLabels = {}
for i = 1, 5 do
    local sym = make("TextLabel", {
        BackgroundTransparency = 1,
        Text = symbols[i],
        TextColor3 = accent,
        TextTransparency = 0.2,
        TextSize = 18 + (i % 3) * 4,
        Font = Enum.Font.GothamBold,
        Size = UDim2.fromOffset(28, 26),
        Position = UDim2.new(1, -30 - i*27, 0, -8)
    }, header)
    table.insert(symbolLabels, sym)
end

local current = make("TextLabel", {
    BackgroundColor3 = panel,
    Position = UDim2.fromOffset(14, 70),
    Size = UDim2.new(1, -28, 0, 66),
    Font = Enum.Font.Gotham,
    Text = "♫  No hay canción reproduciéndose",
    TextColor3 = Color3.new(1,1,1),
    TextSize = 13,
    TextWrapped = true
}, main)
make("UICorner", {CornerRadius = UDim.new(0, 12)}, current)

local idBox = make("TextBox", {
    PlaceholderText = "ID del audio de Roblox...",
    Text = "",
    ClearTextOnFocus = false,
    Font = Enum.Font.Gotham,
    TextSize = 13,
    TextColor3 = Color3.new(1,1,1),
    PlaceholderColor3 = muted,
    BackgroundColor3 = panel,
    Position = UDim2.fromOffset(14, 147),
    Size = UDim2.new(1, -112, 0, 42)
}, main)
make("UICorner", {CornerRadius = UDim.new(0, 10)}, idBox)

local add = make("TextButton", {
    Text = "+ AGREGAR",
    Font = Enum.Font.GothamBold,
    TextSize = 11,
    TextColor3 = Color3.new(1,1,1),
    BackgroundColor3 = accent,
    Position = UDim2.new(1, -91, 0, 147),
    Size = UDim2.fromOffset(77, 42)
}, main)
make("UICorner", {CornerRadius = UDim.new(0, 10)}, add)

local skip = make("TextButton", {
    Text = "⏭  SIGUIENTE",
    Font = Enum.Font.GothamBold,
    TextSize = 12,
    TextColor3 = Color3.new(1,1,1),
    BackgroundColor3 = Color3.fromRGB(72, 54, 83),
    Position = UDim2.fromOffset(14, 198),
    Size = UDim2.new(1, -28, 0, 36)
}, main)
make("UICorner", {CornerRadius = UDim.new(0, 10)}, skip)

make("TextLabel", {
    BackgroundTransparency = 1,
    Text = "SIGUIENTES EN LA COLA",
    Font = Enum.Font.GothamBold,
    TextSize = 10,
    TextColor3 = muted,
    TextXAlignment = Enum.TextXAlignment.Left,
    Position = UDim2.fromOffset(17, 245),
    Size = UDim2.new(1, -34, 0, 18)
}, main)

local queueFrame = make("ScrollingFrame", {
    BackgroundColor3 = panel,
    BorderSizePixel = 0,
    Position = UDim2.fromOffset(14, 267),
    Size = UDim2.new(1, -28, 1, -282),
    CanvasSize = UDim2.new(0,0,0,0),
    ScrollBarThickness = 4,
    ScrollBarImageColor3 = accent
}, main)
make("UICorner", {CornerRadius = UDim.new(0, 10)}, queueFrame)
local layout = make("UIListLayout", {
    Padding = UDim.new(0, 5),
    SortOrder = Enum.SortOrder.LayoutOrder
}, queueFrame)
layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
    queueFrame.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
end)

local notice = make("TextLabel", {
    BackgroundTransparency = 1,
    Text = "",
    Font = Enum.Font.Gotham,
    TextSize = 10,
    TextColor3 = accent,
    TextWrapped = true,
    Position = UDim2.new(0, 14, 1, -18),
    Size = UDim2.new(1, -28, 0, 14)
}, main)

local isOpen = false
local busy = false
local function openPanel()
    if busy or isOpen then return end
    busy = true
    isOpen = true
    main.Visible = true
    main.Size = UDim2.fromOffset(0, 0)
    main.Position = UDim2.new(0.5, 0, 0.5, 18)
    for i, sym in ipairs(symbolLabels) do
        sym.Text = symbols[((i + math.random(0, 5) - 1) % #symbols) + 1]
        sym.TextTransparency = 0.05
        TweenService:Create(sym, TweenInfo.new(0.35, Enum.EasingStyle.Back), {
            Position = UDim2.new(1, -30 - i*27, 0, 12),
            Rotation = (i % 2 == 0) and 18 or -18
        }):Play()
    end
    local tween = TweenService:Create(main, TweenInfo.new(0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.fromOffset(360, 390),
        Position = UDim2.new(0.5, 0, 0.5, 0)
    })
    tween:Play()
    tween.Completed:Wait()
    busy = false
end

local function closePanel()
    if busy or not isOpen then return end
    busy = true
    isOpen = false
    local tween = TweenService:Create(main, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.fromOffset(0, 0),
        Position = UDim2.new(0.5, 0, 0.5, 18)
    })
    tween:Play()
    tween.Completed:Wait()
    main.Visible = false
    for i, sym in ipairs(symbolLabels) do
        sym.Position = UDim2.new(1, -30 - i*27, 0, -8)
        sym.Rotation = 0
    end
    busy = false
end

openButton.Activated:Connect(openPanel)
close.Activated:Connect(closePanel)

add.Activated:Connect(function()
    local id = idBox.Text:match("%d+")
    if not id then
        notice.Text = "Escribe el ID numérico del audio."
        return
    end
    Request:FireServer("Add", id)
    idBox.Text = ""
    notice.Text = "Solicitud enviada..."
end)

skip.Activated:Connect(function()
    Request:FireServer("Skip")
end)

local function render(state)
    if not state then return end
    if state.currentId then
        current.Text = "♫  Reproduciendo: " .. tostring(state.currentId) ..
            "\nAgregó: " .. tostring(state.currentRequester or "Jugador")
    else
        current.Text = "♫  No hay canción reproduciéndose"
    end
    for _, child in ipairs(queueFrame:GetChildren()) do
        if child:IsA("TextLabel") then child:Destroy() end
    end
    for i, item in ipairs(state.queue or {}) do
        make("TextLabel", {
            BackgroundTransparency = 1,
            Text = string.format("%02d   Audio %s   •   %s", i, tostring(item.id), tostring(item.requester)),
            Font = Enum.Font.Gotham,
            TextSize = 11,
            TextColor3 = Color3.new(1,1,1),
            TextXAlignment = Enum.TextXAlignment.Left,
            Size = UDim2.new(1, -12, 0, 27),
            LayoutOrder = i
        }, queueFrame)
    end
end

Update.OnClientEvent:Connect(function(kind, data)
    if kind == "State" then
        render(data)
    elseif kind == "Notice" then
        notice.Text = tostring(data)
    end
end)

Request:FireServer("GetState")
]]></ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>
