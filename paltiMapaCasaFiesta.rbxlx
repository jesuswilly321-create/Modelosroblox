ent="RBX2262"><Properties><string name="Name">Atmosphere</string><float name="Density">0.22</float><float name="Offset">0.1</float><Color3 name="Color"><R>0.200000</R><G>0.240000</G><B>0.400000</B></Color3><Color3 name="Decay"><R>0.100000</R><G>0.120000</G><B>0.250000</B></Color3><float name="Glare">0</float><float name="Haze">1.5</float></Properties></Item><Item class="BloomEffect" referent="RBX2263"><Properties><string name="Name">Bloom</string><float name="Intensity">0.55</float><float name="Size">26</float><float name="Threshold">1.1</float></Properties></Item><Item class="ColorCorrectionEffect" referent="RBX2264"><Properties><string name="Name">Tono</string><float name="Saturation">0.12</float><float name="Contrast">0.1</float></Properties></Item></Item><Item class="ServerScriptService" referent="RBX2265"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX2266"><Properties><string name="Name">LucesFiesta</string><ProtectedString name="Source"><![CDATA[local RunService = game:GetService("RunService")
local carpeta = workspace:WaitForChild("LucesFiesta")
local luces = {}
for _, d in ipairs(carpeta:GetDescendants()) do
	if d:IsA("PointLight") or d:IsA("SpotLight") then
		table.insert(luces, {l = d, off = math.random()})
	end
end
RunService.Heartbeat:Connect(function()
	local t = os.clock() * 0.15
	for _, e in ipairs(luces) do
		e.l.Color = Color3.fromHSV((t + e.off) % 1, 0.8, 1)
	end
end)
]]></ProtectedString></Properties></Item></Item></roblox>