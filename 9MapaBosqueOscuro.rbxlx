while true do
	luz.Brightness = 1.8 + math.random() * 2.4
	if math.random() < 0.05 then
		luz.Brightness = 0.3
		task.wait(0.1)
	end
	task.wait(0.07 + math.random() * 0.12)
end
]]></ProtectedString></Properties></Item></Item></roblox>