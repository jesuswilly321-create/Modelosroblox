ass="ServerScriptService" referent="RBX1148"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX1149"><Properties><string name="Name">ParpadeoFogata</string><ProtectedString name="Source"><![CDATA[-- Fogata inquietante: la luz verde parpadea
local luz = workspace:WaitForChild("Fogata"):WaitForChild("Fuego"):WaitForChild("Luz")
while true do
	luz.Brightness = 1.5 + math.random() * 2.5
	if math.random() < 0.06 then
		luz.Brightness = 0.2
		task.wait(0.12)
	end
	task.wait(0.07 + math.random() * 0.12)
end
]]></ProtectedString></Properties></Item></Item></roblox>