<bool name="Anchored">true</bool><bool name="CanCollide">false</bool><CoordinateFrame name="CFrame"><X>78.192979</X><Y>101.414375</Y><Z>-7.860011</Z><R00>1.000000</R00><R01>0.000000</R01><R02>0.000000</R02><R10>0.000000</R10><R11>1.000000</R11><R12>0.000000</R12><R20>0.000000</R20><R21>0.000000</R21><R22>1.000000</R22></CoordinateFrame><Vector3 name="size"><X>3.850500</X><Y>3.850500</Y><Z>0.900000</Z></Vector3><Color3uint8 name="Color3uint8">4294967295</Color3uint8><token name="Material">288</token><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="shape">1</token></Properties></Item></Item></Item></Item><Item class="Lighting" referent="RBX1708"><Properties><string name="Name">Lighting</string><Color3 name="Ambient"><R>0.350000</R><G>0.350000</G><B>0.350000</B></Color3><Color3 name="OutdoorAmbient"><R>0.450000</R><G>0.450000</G><B>0.450000</B></Color3><Color3 name="FogColor"><R>0.500000</R><G>0.500000</G><B>0.500000</B></Color3><float name="Brightness">2</float><float name="ClockTime">14</float><float name="FogEnd">100000</float><bool name="GlobalShadows">true</bool><token name="Technology">2</token></Properties><Item class="Atmosphere" referent="RBX1709"><Properties><string name="Name">Atmosphere</string><float name="Density">0.5</float><float name="Offset">0.25</float><Color3 name="Color"><R>0.600000</R><G>0.600000</G><B>0.600000</B></Color3><Color3 name="Decay"><R>0.500000</R><G>0.500000</G><B>0.500000</B></Color3><float name="Glare">0</float><float name="Haze">2</float></Properties></Item><Item class="ColorCorrectionEffect" referent="RBX1710"><Properties><string name="Name">Grises</string><float name="Saturation">-1</float><float name="Contrast">0.15</float><float name="Brightness">-0.03</float></Properties></Item><Item class="BloomEffect" referent="RBX1711"><Properties><string name="Name">Bloom</string><float name="Intensity">0.6</float><float name="Size">28</float><float name="Threshold">1.2</float></Properties></Item></Item><Item class="ServerScriptService" referent="RBX1712"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX1713"><Properties><string name="Name">AnimarEstrellas</string><token name="RunContext">0</token><ProtectedString name="Source"><![CDATA[-- Estrellas flotando y girando suavemente
local RunService = game:GetService("RunService")
local folder = workspace:WaitForChild("Estrellas")
local stars = {}
for _, m in ipairs(folder:GetChildren()) do
	table.insert(stars, {model = m, base = m:GetPivot(), phase = math.random() * 6.28, speed = 0.3 + math.random() * 0.5})
end
RunService.Heartbeat:Connect(function()
	local t = os.clock()
	for _, s in ipairs(stars) do
		local bob = math.sin(t * s.speed + s.phase) * 2
		s.model:PivotTo(s.base * CFrame.Angles(0, t * s.speed * 0.6, 0) + Vector3.new(0, bob, 0))
	end
end)
]]></ProtectedString></Properties></Item></Item></roblox>