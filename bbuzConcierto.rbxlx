<Item class="Script" referent="SCR"><Properties><string name="Name">MoverLuz</string><token name="RunContext">2</token><ProtectedString name="Source"><![CDATA[
-- Luz de concierto movil. Ajustes: carpeta "Ajustes" (valores editables).
local RunService = game:GetService("RunService")
local modelo = script.Parent
local base = modelo:WaitForChild("Fijo"):WaitForChild("Base")
local carpetaPan = modelo:WaitForChild("Pan")
local carpetaTilt = modelo:WaitForChild("Tilt")
local ajustes = modelo:WaitForChild("Ajustes")
local lente = carpetaTilt:WaitForChild("Lente")
local foco = lente:WaitForChild("Luz")

local function val(nombre, def)
	local v = ajustes:FindFirstChild(nombre)
	if v then return v.Value end
	return def
end

local ALTURA = 6.5
local baseCF = base.CFrame
local pivoteInicial = baseCF * CFrame.new(0, ALTURA, 0)

local partesPan, partesTilt, colorables = {}, {}, {}
for _, p in ipairs(carpetaPan:GetChildren()) do
	if p:IsA("BasePart") then
		table.insert(partesPan, {p, baseCF:ToObjectSpace(p.CFrame)})
	end
end
for _, p in ipairs(carpetaTilt:GetChildren()) do
	if p:IsA("BasePart") then
		table.insert(partesTilt, {p, pivoteInicial:ToObjectSpace(p.CFrame)})
		if p.Name == "Haz" or p.Name == "Nucleo" or p.Name == "Lente" then
			table.insert(colorables, p)
		end
	end
end

local colores = {
	Color3.fromRGB(255, 230, 60),
	Color3.fromRGB(60, 100, 255),
	Color3.fromRGB(255, 60, 170),
	Color3.fromRGB(255, 255, 255),
	Color3.fromRGB(60, 255, 130),
	Color3.fromRGB(255, 120, 30),
}

local fase = val("Fase", 0)
if fase == 0 then
	fase = (baseCF.Position.X * 0.37 + baseCF.Position.Z * 0.23) % 6.28
end

local evento = RunService:IsClient() and RunService.RenderStepped or RunService.Heartbeat
evento:Connect(function()
	local ahora = workspace:GetServerTimeNow()
	local t = ahora * val("Velocidad", 1) + fase

	local pan = math.rad(val("PanMax", 100)) * math.sin(t * 0.6)
	local tmin = math.rad(val("TiltMin", 5))
	local tmax = math.rad(val("TiltMax", 70))
	local tilt = tmin + (tmax - tmin) * (0.5 + 0.5 * math.sin(t * 1.1 + 1.3))

	local panCF = baseCF * CFrame.Angles(0, pan, 0)
	local pivoteCF = panCF * CFrame.new(0, ALTURA, 0) * CFrame.Angles(tilt, 0, 0)

	for _, d in ipairs(partesPan) do
		d[1].CFrame = panCF * d[2]
	end
	for _, d in ipairs(partesTilt) do
		d[1].CFrame = pivoteCF * d[2]
	end

	local seg = math.max(val("SegundosColor", 4), 0.5)
	local ciclo = ahora / seg
	local i = math.floor(ciclo) % #colores + 1
	local j = i % #colores + 1
	local mezcla = math.clamp((ciclo % 1 - 0.8) / 0.2, 0, 1)
	local color = colores[i]:Lerp(colores[j], mezcla)
	for _, p in ipairs(colorables) do
		p.Color = color
	end
	foco.Color = color
end)
]]></ProtectedString></Properties></Item>
</Item></Item></roblox>