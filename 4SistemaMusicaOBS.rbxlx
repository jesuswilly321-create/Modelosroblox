"G66"><Properties><string name="Name">UITextSizeConstraint</string><float name="MaxTextSize">16</float><float name="MinTextSize">8</float></Properties></Item></Item><Item class="TextButton" referent="G68"><Properties><string name="Name">Corazon</string><string name="Text">♥</string><UDim2 name="Position"><XS>0.82</XS><XO>0</XO><YS>0.12</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.14</XS><XO>0</XO><YS>0.76</YS><YO>0</YO></UDim2><token name="Font">19</token><Color3 name="TextColor3"><R>0.745098</R><G>0.745098</G><B>0.745098</B></Color3><Color3 name="BackgroundColor3"><R>0.000000</R><G>0.000000</G><B>0.000000</B></Color3><bool name="TextScaled">true</bool><bool name="AutoButtonColor">false</bool><int name="BorderSizePixel">0</int><float name="BackgroundTransparency">1</float><int name="ZIndex">3</int></Properties></Item></Item><Item class="TextLabel" referent="G71"><Properties><string name="Name">MensajeVacio</string><string name="Text"></string><UDim2 name="Position"><XS>0</XS><XO>0</XO><YS>0</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>-8</XO><YS>0</YS><YO>70</YO></UDim2><token name="Font">17</token><Color3 name="TextColor3"><R>0.745098</R><G>0.745098</G><B>0.745098</B></Color3><token name="TextXAlignment">2</token><bool name="TextScaled">true</bool><float name="BackgroundTransparency">1</float><int name="BorderSizePixel">0</int><bool name="Visible">false</bool></Properties><Item class="UITextSizeConstraint" referent="G70"><Properties><string name="Name">UITextSizeConstraint</string><float name="MaxTextSize">18</float><float name="MinTextSize">8</float></Properties></Item></Item><Item class="TextLabel" referent="G73"><Properties><string name="Name">Aviso</string><string name="Text"></string><UDim2 name="Position"><XS>0.5</XS><XO>0</XO><YS>0</YS><YO>14</YO></UDim2><UDim2 name="Size"><XS>0</XS><XO>320</XO><YS>0</YS><YO>38</YO></UDim2><Color3 name="BackgroundColor3"><R>0.078431</R><G>0.078431</G><B>0.078431</B></Color3><Color3 name="TextColor3"><R>1.000000</R><G>1.000000</G><B>1.000000</B></Color3><token name="Font">19</token><int name="TextSize">16</int><bool name="Visible">false</bool><Vector2 name="AnchorPoint"><X>0.5</X><Y>0</Y></Vector2><int name="BorderSizePixel">0</int></Properties><Item class="UICorner" referent="G72"><Properties><string name="Name">UICorner</string><UDim name="CornerRadius"><S>0</S><O>10</O></UDim></Properties></Item></Item><Item class="LocalScript" referent="G_ls"><Properties><string name="Name">MusicaCliente</string><ProtectedString name="Source"><![CDATA[-- MUSICA GLOBAL (cliente): lógica del panel OBS. La interfaz ya está armada en este ScreenGui.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContentProvider = game:GetService("ContentProvider")

local gui = script.Parent
local R = RS:WaitForChild("MusicaRemotes")
local Canciones = require(RS:WaitForChild("Canciones"))

local BLANCO = Color3.fromRGB(255, 255, 255)
local NEGRO = Color3.fromRGB(0, 0, 0)
local GRIS = Color3.fromRGB(110, 110, 110)
local GRIS_TXT = Color3.fromRGB(190, 190, 190)
local ROSA = Color3.fromRGB(255, 90, 130)

-- referencias a la interfaz
local abrir = gui:WaitForChild("Abrir")
local panel = gui:WaitForChild("Panel")
local plantilla = gui:WaitForChild("FilaPlantilla")
local plantillaVacio = gui:WaitForChild("MensajeVacio")
local toast = gui:WaitForChild("Aviso")

local cerrar = panel:WaitForChild("Cerrar")
local busq = panel:WaitForChild("CajaBusqueda"):WaitForChild("Busqueda")
local btnSaltar = panel:WaitForChild("BtnSaltar")
local lista = panel:WaitForChild("Lista")
local volPct = panel:WaitForChild("VolPct")
local pista = panel:WaitForChild("VolPista")
local relleno_vol = pista:WaitForChild("VolRelleno")
local perilla = pista:WaitForChild("VolPerilla")
local nombreActual = panel:WaitForChild("NombreActual")
local artistaActual = panel:WaitForChild("ArtistaActual")
local barraProg = panel:WaitForChild("ProgFondo"):WaitForChild("ProgBarra")
local tIzq = panel:WaitForChild("TiempoIzq")
local tDer = panel:WaitForChild("TiempoDer")

local botonesPestana = {
	Reproductor = panel:WaitForChild("TabReproductor"),
	Playlist = panel:WaitForChild("TabPlaylist"),
	Favorite = panel:WaitForChild("TabFavorite"),
}
local botonesCat = {
	Todos = panel:WaitForChild("CatTodos"),
	Reggaeton = panel:WaitForChild("CatReggaeton"),
	Regional = panel:WaitForChild("CatRegional"),
	House = panel:WaitForChild("CatHouse"),
}

-- sonido local (cada jugador controla su volumen)
local sonido = Instance.new("Sound")
sonido.Name = "MusicaGlobal"
sonido.Looped = false
sonido.Volume = 1
sonido.Parent = SoundService

local pestanaActual = "Reproductor"
local categoria = "Todos"
local estado = {cola = {}, votos = 0, req = 1}
local actual = nil
local favs = {}
local votadoPara = nil
local render

-- aviso emergente
local toastId = 0
local function aviso(msg)
	toastId += 1
	local mi = toastId
	toast.Text = msg
	toast.Visible = true
	task.delay(2.5, function()
		if toastId == mi then toast.Visible = false end
	end)
end

-- volumen
local function fijarVolumen(v)
	v = math.clamp(v, 0, 1)
	sonido.Volume = v
	relleno_vol.Size = UDim2.new(v, 0, 1, 0)
	perilla.Position = UDim2.new(v, 0, 0.5, 0)
	volPct.Text = math.floor(v * 100 + 0.5) .. "%"
end
local arrastrando = false
local function moverVol(pos)
	fijarVolumen((pos.X - pista.AbsolutePosition.X) / pista.AbsoluteSize.X)
end
pista.InputBegan:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
		arrastrando = true
		moverVol(i.Position)
	end
end)
UserInputService.InputChanged:Connect(function(i)
	if arrastrando and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
		moverVol(i.Position)
	end
end)
UserInputService.InputEnded:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
		arrastrando = false
	end
end)

local function fmt(s)
	s = math.max(0, math.floor(s))
	return string.format("%d:%02d", s // 60, s % 60)
end

local ordenados = {}
for i = 1, #Canciones do table.insert(ordenados, i) end
table.sort(ordenados, function(a, b)
	return string.lower(Canciones[a].Nombre) < string.lower(Canciones[b].Nombre)
end)

local function limpiarLista()
	for _, h in ipairs(lista:GetChildren()) do
		if h:IsA("GuiObject") then h:Destroy() end
	end
end

local function fila(orden, titulo, artista, nombreFav, alClick)
	local f = plantilla:Clone()
	f.Name = "Fila"
	f.LayoutOrder = orden
	f.Visible = true
	f.Titulo.Text = titulo
	f.Artista.Text = artista or ""
	local h = f.Corazon
	if nombreFav then
		h.TextColor3 = favs[nombreFav] and ROSA or GRIS_TXT
		h.MouseButton1Click:Connect(function()
			favs[nombreFav] = not favs[nombreFav] or nil
			h.TextColor3 = favs[nombreFav] and ROSA or GRIS_TXT
			R.Favorito:FireServer(nombreFav)
			if pestanaActual == "Favorite" then task.defer(render) end
		end)
	else
		h.Visible = false
	end
	if alClick then f.Boton.MouseButton1Click:Connect(alClick) end
	f.Parent = lista
end

local function mensajeVacio(txt)
	local m = plantillaVacio:Clone()
	m.Name = "Vacio"
	m.Text = txt
	m.Visible = true
	m.Parent = lista
end

render = function()
	limpiarLista()
	local q = string.lower(busq.Text or "")
	local function pasa(c)
		if categoria ~= "Todos" and c.Categoria ~= categoria then return false end
		if q ~= "" then
			local n = string.lower(c.Nombre)
			local ar = string.lower(c.Artista or "")
			if not string.find(n, q, 1, true) and not string.find(ar, q, 1, true) then return false end
		end
		return true
	end
	if pestanaActual == "Reproductor" then
		for orden, i in ipairs(ordenados) do
			local c = Canciones[i]
			if pasa(c) then
				fila(orden, c.Nombre, c.Artista, c.Nombre, function() R.Agregar:FireServer(i) end)
			end
		end
	elseif pestanaActual == "Playlist" then
		local n = 0
		for pos, item in ipairs(estado.cola) do
			local c = Canciones[item.idx]
			if c and pasa(c) then
				n += 1
				fila(pos, "#" .. pos .. "  " .. c.Nombre, c.Artista, nil, nil)
			end
		end
		if n == 0 then mensajeVacio("La cola está vacía. Toca una canción en Reproductor para agregarla.") end
	else
		local n = 0
		for orden, i in ipairs(ordenados) do
			local c = Canciones[i]
			if favs[c.Nombre] and pasa(c) then
				n += 1
				fila(orden, c.Nombre, c.Artista, c.Nombre, function() R.Agregar:FireServer(i) end)
			end
		end
		if n == 0 then mensajeVacio("Aún no tienes favoritas. Toca el corazón de una canción.") end
	end
end

local function pintarBotones()
	for nombre, b in pairs(botonesPestana) do
		local activo = nombre == pestanaActual
		b.BackgroundColor3 = activo and BLANCO or GRIS
		b.TextColor3 = activo and NEGRO or BLANCO
	end
	for nombre, b in pairs(botonesCat) do
		local activo = nombre == categoria
		b.BackgroundColor3 = activo and BLANCO or GRIS
		b.TextColor3 = activo and NEGRO or BLANCO
	end
end

for nombre, b in pairs(botonesPestana) do
	b.MouseButton1Click:Connect(function()
		pestanaActual = nombre
		pintarBotones()
		render()
	end)
end
for nombre, b in pairs(botonesCat) do
	b.MouseButton1Click:Connect(function()
		categoria = nombre
		pintarBotones()
		render()
	end)
end
busq:GetPropertyChangedSignal("Text"):Connect(function() render() end)

btnSaltar.MouseButton1Click:Connect(function()
	if not actual then aviso("No hay música sonando") return end
	if votadoPara == actual.inicio then aviso("Ya votaste para saltar") return end
	votadoPara = actual.inicio
	R.Saltar:FireServer()
end)

-- reproducir sincronizado con el servidor
local function reproducir(mia)
	local c = Canciones[mia.idx]
	if not c then return end
	sonido:Stop()
	sonido.SoundId = "rbxassetid://" .. c.Id
	task.spawn(function()
		pcall(function() ContentProvider:PreloadAsync({sonido}) end)
		if actual ~= mia then return end
		local t0 = os.clock()
		while sonido.TimeLength <= 0 and os.clock() - t0 < 8 do task.wait(0.1) end
		if actual ~= mia then return end
		local pos = workspace:GetServerTimeNow() - mia.inicio
		if sonido.TimeLength > 0 then
			sonido.TimePosition = math.clamp(pos, 0, math.max(0, sonido.TimeLength - 0.2))
		end
		sonido:Play()
	end)
end

local function aplicar(e)
	estado = e
	local nuevo = e.actual
	if nuevo then
		if not actual or actual.inicio ~= nuevo.inicio then
			actual = nuevo
			reproducir(actual)
			local c = Canciones[actual.idx]
			nombreActual.Text = c and c.Nombre or "..."
			artistaActual.Text = c and (c.Artista or "") or ""
		end
	else
		actual = nil
		sonido:Stop()
		nombreActual.Text = "Sin música"
		artistaActual.Text = ""
	end
	btnSaltar.Text = "Saltar  " .. estado.votos .. "/" .. estado.req
	if pestanaActual == "Playlist" then render() end
end

R:WaitForChild("Estado").OnClientEvent:Connect(aplicar)
R:WaitForChild("Aviso").OnClientEvent:Connect(aviso)

-- progreso + corrección de desfase
local ultimaCorreccion = 0
RunService.Heartbeat:Connect(function()
	if actual then
		local pos = math.clamp(workspace:GetServerTimeNow() - actual.inicio, 0, actual.dur)
		barraProg.Size = UDim2.new(pos / actual.dur, 0, 1, 0)
		tIzq.Text = fmt(pos)
		tDer.Text = fmt(actual.dur)
		if sonido.IsPlaying and os.clock() - ultimaCorreccion > 8 then
			ultimaCorreccion = os.clock()
			if math.abs(sonido.TimePosition - pos) > 2 then sonido.TimePosition = pos end
		end
	else
		barraProg.Size = UDim2.new(0, 0, 1, 0)
		tIzq.Text = "0:00"
		tDer.Text = "0:00"
	end
end)

abrir.MouseButton1Click:Connect(function()
	panel.Visible = not panel.Visible
	if panel.Visible then render() end
end)
cerrar.MouseButton1Click:Connect(function() panel.Visible = false end)

pintarBotones()
fijarVolumen(1)
render()

task.spawn(function()
	local datos = R:WaitForChild("Obtener"):InvokeServer()
	if datos then
		for _, n in ipairs(datos.favs or {}) do favs[n] = true end
		aplicar(datos.estado)
		render()
	end
end)
]]></ProtectedString></Properties></Item></Item></Item></roblox>